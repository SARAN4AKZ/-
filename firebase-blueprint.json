{
  "entities": {
    "OrganizationProfile": {
      "title": "OrganizationProfile",
      "description": "User's own legal entity or individual entrepreneur requisites used as Seller/Shipper in documents.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Owner Firebase Auth UID" },
        "name": { "type": "string", "description": "Short or full organization name" },
        "inn": { "type": "string", "description": "10 or 12 digit INN" },
        "kpp": { "type": "string", "description": "9 digit KPP (empty for IP)" },
        "ogrn": { "type": "string", "description": "13 or 15 digit OGRN/OGRNIP" },
        "address": { "type": "string", "description": "Legal address" },
        "phone": { "type": "string", "description": "Contact phone" },
        "bankName": { "type": "string", "description": "Bank name" },
        "bik": { "type": "string", "description": "9 digit BIK" },
        "checkingAccount": { "type": "string", "description": "20 digit checking account (r/s)" },
        "correspondentAccount": { "type": "string", "description": "20 digit correspondent account (k/s)" },
        "directorTitle": { "type": "string", "description": "Director position title" },
        "directorName": { "type": "string", "description": "Director full name" },
        "accountantName": { "type": "string", "description": "Chief accountant full name" },
        "defaultVatRate": { "type": "integer", "description": "Default VAT rate (-1 for No VAT, 0, 5, 7, 10, 20)" },
        "defaultProfile": { "type": "boolean", "description": "Whether this is the default seller organization" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server timestamp on creation" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server timestamp on update" }
      },
      "required": [
        "userId",
        "name",
        "inn",
        "kpp",
        "ogrn",
        "address",
        "phone",
        "bankName",
        "bik",
        "checkingAccount",
        "correspondentAccount",
        "directorTitle",
        "directorName",
        "accountantName",
        "defaultVatRate",
        "defaultProfile",
        "createdAt",
        "updatedAt"
      ]
    },
    "Counterparty": {
      "title": "Counterparty",
      "description": "Saved buyer/consignee company or individual entrepreneur fetched by INN.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Owner Firebase Auth UID" },
        "name": { "type": "string", "description": "Counterparty name" },
        "inn": { "type": "string", "description": "10 or 12 digit INN" },
        "kpp": { "type": "string", "description": "9 digit KPP" },
        "ogrn": { "type": "string", "description": "OGRN/OGRNIP" },
        "address": { "type": "string", "description": "Legal address" },
        "phone": { "type": "string", "description": "Phone" },
        "bankName": { "type": "string", "description": "Bank name" },
        "bik": { "type": "string", "description": "BIK" },
        "checkingAccount": { "type": "string", "description": "Checking account" },
        "correspondentAccount": { "type": "string", "description": "Correspondent account" },
        "directorName": { "type": "string", "description": "Director name" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server timestamp on creation" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server timestamp on update" }
      },
      "required": [
        "userId",
        "name",
        "inn",
        "kpp",
        "ogrn",
        "address",
        "phone",
        "bankName",
        "bik",
        "checkingAccount",
        "correspondentAccount",
        "directorName",
        "createdAt",
        "updatedAt"
      ]
    },
    "AccountingDocument": {
      "title": "AccountingDocument",
      "description": "Primary accounting document: Invoice (Счёт-фактура) or TORG-12 consignment note.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Owner Firebase Auth UID" },
        "docType": { "type": "string", "enum": ["INVOICE", "TORG12"], "description": "Document type" },
        "docNumber": { "type": "string", "description": "Document number" },
        "docDate": { "type": "string", "description": "Document date DD.MM.YYYY" },
        "basisDoc": { "type": "string", "description": "Basis contract or order" },
        "paymentDoc": { "type": "string", "description": "Payment document reference" },
        "status": { "type": "string", "enum": ["DRAFT", "ISSUED"], "description": "Document lifecycle status" },
        "sellerName": { "type": "string" },
        "sellerInn": { "type": "string" },
        "sellerKpp": { "type": "string" },
        "sellerOgrn": { "type": "string" },
        "sellerAddress": { "type": "string" },
        "sellerPhone": { "type": "string" },
        "sellerBankName": { "type": "string" },
        "sellerBik": { "type": "string" },
        "sellerCheckingAccount": { "type": "string" },
        "sellerCorrAccount": { "type": "string" },
        "sellerDirectorTitle": { "type": "string" },
        "sellerDirectorName": { "type": "string" },
        "sellerAccountantName": { "type": "string" },
        "buyerName": { "type": "string" },
        "buyerInn": { "type": "string" },
        "buyerKpp": { "type": "string" },
        "buyerOgrn": { "type": "string" },
        "buyerAddress": { "type": "string" },
        "buyerPhone": { "type": "string" },
        "buyerBankName": { "type": "string" },
        "buyerBik": { "type": "string" },
        "buyerCheckingAccount": { "type": "string" },
        "buyerCorrAccount": { "type": "string" },
        "consignorInfo": { "type": "string" },
        "consigneeInfo": { "type": "string" },
        "items": { "type": "array", "description": "Bounded list of up to 50 document line items" },
        "subtotalWithoutVat": { "type": "number" },
        "totalVat": { "type": "number" },
        "totalWithVat": { "type": "number" },
        "totalQuantity": { "type": "number" },
        "totalPlaces": { "type": "integer" },
        "totalWeightKg": { "type": "number" },
        "amountInWords": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "userId",
        "docType",
        "docNumber",
        "docDate",
        "basisDoc",
        "paymentDoc",
        "status",
        "sellerName",
        "sellerInn",
        "sellerKpp",
        "sellerOgrn",
        "sellerAddress",
        "sellerPhone",
        "sellerBankName",
        "sellerBik",
        "sellerCheckingAccount",
        "sellerCorrAccount",
        "sellerDirectorTitle",
        "sellerDirectorName",
        "sellerAccountantName",
        "buyerName",
        "buyerInn",
        "buyerKpp",
        "buyerOgrn",
        "buyerAddress",
        "buyerPhone",
        "buyerBankName",
        "buyerBik",
        "buyerCheckingAccount",
        "buyerCorrAccount",
        "consignorInfo",
        "consigneeInfo",
        "items",
        "subtotalWithoutVat",
        "totalVat",
        "totalWithVat",
        "totalQuantity",
        "totalPlaces",
        "totalWeightKg",
        "amountInWords",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}/organizations/{orgId}": {
      "schema": { "$ref": "#/entities/OrganizationProfile" },
      "description": "User-owned seller organization profiles"
    },
    "/users/{userId}/counterparties/{partyId}": {
      "schema": { "$ref": "#/entities/Counterparty" },
      "description": "User-owned counterparty directory"
    },
    "/users/{userId}/documents/{docId}": {
      "schema": { "$ref": "#/entities/AccountingDocument" },
      "description": "User-owned Счёт-фактура and ТОРГ-12 documents"
    }
  }
}
